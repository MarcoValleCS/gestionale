# Copiare questo file in «.env» e personalizzare i valori prima di avviare.

# Chiave segreta Django: generare una stringa lunga e casuale
# (es. con il comando:  python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cambiare-con-una-stringa-lunga-e-casuale
DJANGO_DEBUG=false

# Dominio (o IP) con cui si accede al gestionale
DOMAIN=gestionale.tuodominio.it
DJANGO_ALLOWED_HOSTS=gestionale.tuodominio.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionale.tuodominio.it
DJANGO_HTTPS=true

# Primo utente amministratore (creato automaticamente al primo avvio).
# Scegli una password lunga e casuale (minimo 10 caratteri) e cambiala al primo accesso.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-questa-password-lunga-e-casuale
DJANGO_SUPERUSER_EMAIL=marco@example.com

# Database PostgreSQL (gestito da Docker Compose)
DB_NAME=gestionale
DB_USER=gestionale
DB_PASSWORD=cambiare-questa-password

# Email per l'invio di fatture/preventivi.
# Per la fatturazione elettronica usare le credenziali SMTP della casella PEC.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Timeout di rete per l'invio (secondi): evita che un SMTP lento blocchi i worker
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Gestionale <nome@tuodominio.it>

# Posta in arrivo (IMAP, facoltativa): per leggere la casella aziendale dal gestionale.
# Se non indicate si usano le stesse credenziali dell'invio.
IMAP_HOST=imaps.aruba.it
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Avvisi automatici (backup fallito, sito irraggiungibile, disco pieno).
# Se vuoto si usa l'email dell'azienda (Impostazioni → Dati azienda).
AVVISO_EMAIL=

# Token condiviso col sito web (aquaforma.it) per la ricezione dei lead dal
# modulo contatti (endpoint /lead/da-sito/). Generare una stringa esadecimale
# casuale (es. openssl rand -hex 32) e riportare lo stesso valore nel .env del
# sito. Se vuoto, l'endpoint risponde 503 e non accetta nulla.
LEAD_SITO_TOKEN=

# Se impostato, ogni notte il backup del database arriva qui come allegato:
# è la copia che resta fuori dal server.
BACKUP_EMAIL=

# Indirizzo PEC del Sistema di Interscambio (di norma non va cambiato)
SDI_PEC_ADDRESS=sdi01@pec.fatturapa.it

# ------------------------------------------------- server MCP (assistenti AI)
# Il server MCP permette agli assistenti AI di leggere e scrivere il
# gestionale. In produzione gira dietro Caddy (https://<dominio>/mcp) e ogni
# richiesta deve avere l'intestazione «Authorization: Bearer <token>».
#
# Per accenderlo: mettere MCP_ENABLED=true e generare un token con
#   openssl rand -hex 32
# poi avviare il servizio con «docker compose --profile mcp up -d».
MCP_ENABLED=false
# Token Bearer (segreto: non va pubblicato né condiviso).
MCP_TOKEN=
# Utente del gestionale a cui sono attribuite le scritture (deve esistere).
MCP_USER=admin
# Token aggiuntivi, uno per utente: formato «token:utente» separati da virgola.
# Con lo scope in fondo si può limitare un token alle sole letture:
#   «token:utente:mcp:sola-lettura»
MCP_TOKENS=
# IP ammessi (facoltativo, separati da virgola). Se vuoto vale solo il token.
MCP_ALLOWED_IPS=
# Quante richieste al minuto per token (0 = senza limite).
MCP_RATE_LIMIT=300
# Host e origini ammessi dal server MCP (protezione DNS rebinding).
# Se vuoto si usa DOMAIN.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
