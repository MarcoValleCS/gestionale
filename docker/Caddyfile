{$DOMAIN} {
	encode zstd gzip

	# Log degli accessi con durata della risposta: servono per trovare le
	# pagine lente (i tempi finiscono nei log Docker, già ruotati).
	log {
		output stdout
		format json
	}

	# Header di sicurezza
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Tutto è servito dal gestionale (niente CDN esterni). 'unsafe-inline' serve
		# per il tema (stili) e per i piccoli script inline già presenti nelle pagine.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; worker-src 'self'; manifest-src 'self'"
	}

	# Limite dimensione richieste (protegge da upload abnormi)
	request_body {
		max_size 25MB
	}

	reverse_proxy web:8000
}
